/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; worker-src 'self' blob:; connect-src 'self' https://api.triggerx.in https://triggerx-api.azurewebsites.net https://cloudflareinsights.com https://api.binance.com wss://stream.binance.com:9443 wss://stream.binance.com; frame-ancestors 'none'

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/draco/*
  Cache-Control: public, max-age=31536000, immutable

/*.glb
  Cache-Control: public, max-age=31536000, immutable

/*.hdr
  Cache-Control: public, max-age=31536000, immutable

/hero-poster.webp
  Cache-Control: public, max-age=604800

/*.mp4
  Cache-Control: public, max-age=604800

/*.webm
  Cache-Control: public, max-age=604800

/favicon.svg
  Cache-Control: public, max-age=86400

/index.html
  Cache-Control: no-cache, no-store, must-revalidate
